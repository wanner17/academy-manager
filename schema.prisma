generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 학생 정보
model Student {
  id          Int          @id @default(autoincrement())
  name        String
  school      String
  grade       Int
  phone       String
  logs        ConsultLog[]
  attendance  Attendance[]
}

// 상담 기록
model ConsultLog {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

// 출결 기록
model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  date      DateTime
  status    String   // PRESENT(출석), ABSENT(결석), LATE(지각) 등
}

// 수업 일정
model Schedule {
  id        Int      @id @default(autoincrement())
  title     String
  start     DateTime
  end       DateTime
  room      String?
  teacherId String
}

// 업무 관리 (To-do List)
model Todo {
  id          Int      @id @default(autoincrement())
  content     String
  isCompleted Boolean  @default(false)
  category    String   // COMMON(전체), TEACHER(강사), ASSISTANT(조교)
  updatedBy   String?  // 마지막으로 수정한 사람 이름
  updatedAt   DateTime @updatedAt
}