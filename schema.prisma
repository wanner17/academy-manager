generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  role         String   // TEACHER | ASSISTANT
  createdById  Int?
  createdBy    User?    @relation("CreatedBy", fields: [createdById], references: [id])
  createdUsers User[]   @relation("CreatedBy")
  assignedTodos Todo[]
  schedules    Schedule[]
  createdAt    DateTime @default(now())
}

// 학생 정보
model Student {
  id          Int          @id @default(autoincrement())
  name        String
  school      String
  grade       Int
  phone       String
  logs        ConsultLog[]
  attendance  Attendance[]
}

// 상담 기록
model ConsultLog {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

// 출결 기록
model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  date      DateTime
  status    String   // PRESENT(출석), ABSENT(결석), LATE(지각)
}

// 수업 일정
model Schedule {
  id        Int      @id @default(autoincrement())
  title     String
  start     DateTime
  end       DateTime
  room      String?
  teacherId Int
  teacher   User     @relation(fields: [teacherId], references: [id])
}

// 업무 관리 (To-do List)
model Todo {
  id           Int      @id @default(autoincrement())
  content      String
  detail       String?
  isCompleted  Boolean  @default(false)
  category     String   // COMMON(전체), TEACHER(강사), ASSISTANT(조교)
  assignedToId Int?
  assignedTo   User?    @relation(fields: [assignedToId], references: [id])
  updatedBy    String?
  updatedAt    DateTime @updatedAt
}
